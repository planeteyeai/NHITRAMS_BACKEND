# Copy to .env for local development, or set the same keys on Railway for production.
# Never commit real secrets.

# ---------------------------------------------------------------------------
# Environment switch
#   development | local | dev  → use DATABASE_* (local PostgreSQL)
#   production (default)       → use DB_* (Neon / Railway — unchanged)
# ---------------------------------------------------------------------------
DJANGO_ENV=development

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# JWT (AI Identifier)
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=86400

# AWS S3 (DPR evidence → nhitbucket / Damaged Assets)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=nhitbucket
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_DPR_FOLDER=Damaged Assets
# AWS_DEFAULT_ACL=public-read
AWS_S3_MAX_UPLOAD_BYTES=10485760
AWS_S3_MAX_VIDEO_UPLOAD_BYTES=104857600

# ---------------------------------------------------------------------------
# LOCAL PostgreSQL (used when DJANGO_ENV=development)
# ---------------------------------------------------------------------------
DATABASE_NAME=nhit
DATABASE_USER=postgres
DATABASE_PASSWORD=root
DATABASE_HOST=localhost
DATABASE_PORT=5432
DB_SSLMODE=prefer
# DB_SEARCH_PATH=public

# ---------------------------------------------------------------------------
# PRODUCTION / Neon (used when DJANGO_ENV=production or unset)
# Keep these exact variable names on Railway — do not rename.
# ---------------------------------------------------------------------------
# DJANGO_ENV=production
# DJANGO_DEBUG=False
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=your-password
# DB_HOST=ep-xxxx.aws.neon.tech
# DB_PORT=5432
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=60
# DB_SEARCH_PATH=

# CORS / CSRF
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com

# ---------------------------------------------------------------------------
# Redis (optional — caching disabled when REDIS_URL unset)
#
# REDIS_URL          — active connection used by the application
# REDIS_INTERNAL_URL — Railway private network (redis.railway.internal:6379)
# REDIS_PUBLIC_URL   — Railway public proxy (for local dev / external access)
#
# Benchmarks swap REDIS_URL at runtime; app keeps using REDIS_URL unless overridden.
# Never commit real passwords — use Railway secrets / local .env only.
# ---------------------------------------------------------------------------
# REDIS_URL=
# REDIS_INTERNAL_URL=redis://default:YOUR_PASSWORD@redis.railway.internal:6379
# REDIS_PUBLIC_URL=redis://default:YOUR_PASSWORD@YOUR_PROXY.rlwy.net:PORT

# Gunicorn / container
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
RUN_MIGRATIONS=true
COLLECT_STATIC=true
WAIT_FOR_DB=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Distress PDF async export (Railway worker)
#
# Web service (unchanged):
#   gunicorn nhit.wsgi:application
#
# Worker service (same Docker image, different start command):
#   python manage.py run_distress_export_worker
#
# Uses PostgreSQL job rows — Redis is NOT required for the export queue.
# Requires the same DB_* / DATABASE_* and AWS_* variables as the web service.
# Optional:
#   AWS_S3_DISTRESS_PDF_FOLDER=Distress PDF Exports
#   AWS_S3_PDF_PRESIGN_EXPIRES_SECONDS=3600
#
# Worker concurrency is fixed at 1 in application logic. Prefer >=1 GB RAM
# for the worker service after measuring large (32-report) exports.
# ---------------------------------------------------------------------------
# AWS_S3_DISTRESS_PDF_FOLDER=Distress PDF Exports
# AWS_S3_PDF_PRESIGN_EXPIRES_SECONDS=3600

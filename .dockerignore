# Git / VCS
.git
.gitignore
.gitattributes

# Environment & secrets — never bake into the image
.env
.env.*
!.env.example

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# Tests / coverage / tooling
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/
.claude/
.cursor/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docs & local artifacts
*.md
!README.md
staticfiles/
media/
*.log
docker-compose.override.yml

# Docker (avoid recursive context weirdness)
Dockerfile*
docker-compose*.yml
